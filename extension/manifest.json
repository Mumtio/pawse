{
  "manifest_version": 3,
  "name": "Pawse Gatekeeper",
  "version": "0.1.0",
  "description": "Hides feeds and recommendations while Pawse is in a focus session, and tells the cat when scrolling has gone on a while.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:17342/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://x.com/*",
        "*://*.twitter.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["hide.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pawse Gatekeeper",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
